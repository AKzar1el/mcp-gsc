# Local development secrets for `wrangler dev`.
# Copy this file to `.dev.vars` (gitignored) and fill in your own values.
# In production, set secrets with `wrangler secret put <NAME>` and configure
# GSC_ACCESS_MODE in wrangler.jsonc.
# See SETUP.md for how to obtain each value.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Start new installations with read-only analytics access. The runtime fallback
# is still readwrite when unset, for compatibility with existing installations.
# Explicitly opt into readwrite only when write tools and scopes are needed.
GSC_ACCESS_MODE=readonly
