{
  "name": "@digestseo/mcp-gsc",
  "version": "0.3.1",
  "private": false,
  "main": "scripts/glama-start.mjs",
  "bin": {
    "mcp-gsc": "scripts/glama-start.mjs"
  },
  "license": "MIT",
  "description": "Self-hostable Google Search Console MCP server for analytics, URL inspection, sitemaps, indexing, and SEO reporting on Cloudflare Workers.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKzar1el/mcp-gsc.git"
  },
  "homepage": "https://digestseo.com/gsc-mcp/",
  "author": {
    "name": "DigestSEO",
    "url": "https://digestseo.com/"
  },
  "bugs": {
    "url": "https://github.com/AKzar1el/mcp-gsc/issues"
  },
  "files": [
    "src",
    "scripts/glama-start.mjs",
    "wrangler.example.jsonc",
    ".dev.vars.example",
    "README.md",
    "SETUP.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-search-console",
    "google-search-console-mcp",
    "search-console",
    "search-analytics",
    "indexing-api",
    "seo",
    "cloudflare-workers",
    "claude"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run typecheck",
    "start": "node scripts/glama-start.mjs",
    "typecheck": "tsc --noEmit",
    "test:oauth-state": "tsx --test tests/pending-auth-state.test.ts",
    "test:comparison": "tsx --test tests/performance-comparison.test.ts",
    "test:annotations": "tsx --test tests/write-tool-annotations.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:access-mode": "tsx --test tests/access-mode.test.ts",
    "test:access-token-lifecycle": "tsx --test tests/access-token-lifecycle.test.ts",
    "test:analytics-response-metadata": "tsx --test tests/analytics-response-metadata.test.ts",
    "test": "npm run typecheck && npm run test:metadata && npm run test:oauth-state && npm run test:comparison && npm run test:annotations && npm run test:worker && npm run test:access-mode && npm run test:access-token-lifecycle && npm run test:analytics-response-metadata && npm run test:unit",
    "test:metadata": "tsx --test tests/metadata.test.ts",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "mcpName": "io.github.AKzar1el/mcp-gsc",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.13.1",
    "wrangler": "^4.93.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^4.20260520.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
